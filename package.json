{
  "name": "dsh-chat-width",
  "version": "1.0.0",
  "description": "Separate Chat column width and Composer width sliders for the DSH Web UI — wide screens stop wasting the middle column.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "web-ui",
    "width",
    "layout",
    "settings"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongrd666/dsh-chat-width.git"
  },
  "homepage": "https://github.com/dongrd666/dsh-chat-width#readme",
  "bugs": {
    "url": "https://github.com/dongrd666/dsh-chat-width/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.png",
    "README.md",
    "README_ZH.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
